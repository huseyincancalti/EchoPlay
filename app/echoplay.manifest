<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<!-- EchoPlay.exe's manifest (app/echoplay.rc.in embeds it). Windows 10/11 support is claimed so the frameless window
     gets the snap layouts flyout on its maximize button (qwindowkit and VLC ship the same). No DPI entry: Qt sets
     per-monitor awareness itself, and a manifest entry would conflict with it. -->
<assembly xmlns="urn:schemas-microsoft-com:asm.v1" manifestVersion="1.0">
  <trustInfo xmlns="urn:schemas-microsoft-com:asm.v3">
    <security>
      <requestedPrivileges>
        <requestedExecutionLevel level="asInvoker" uiAccess="false"/>
      </requestedPrivileges>
    </security>
  </trustInfo>
  <compatibility xmlns="urn:schemas-microsoft-com:compatibility.v1">
    <application>
      <!-- Windows 10 and 11 -->
      <supportedOS Id="{8e0f7a12-bfb3-4fe8-b9a5-48fd50a15a9a}"/>
    </application>
  </compatibility>
</assembly>
