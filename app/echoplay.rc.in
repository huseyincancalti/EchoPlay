// Windows resources of EchoPlay.exe (app/CMakeLists.txt fills in the @...@ values).
// IDI_ICON1: the exe icon in Explorer and the taskbar; Qt also uses it as the default window icon.
IDI_ICON1 ICON "@ECHOPLAY_ICON@"

// Version info: Task Manager shows FileDescription; file properties show the rest.
1 VERSIONINFO
FILEVERSION @ECHOPLAY_VERSION_RC@
PRODUCTVERSION @ECHOPLAY_VERSION_RC@
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "CompanyName", "Huseyin Can CALTI"
            VALUE "FileDescription", "EchoPlay"
            VALUE "FileVersion", "@ECHOPLAY_VERSION@"
            VALUE "LegalCopyright", "Copyright (c) 2026 Huseyin Can CALTI, MIT License"
            VALUE "OriginalFilename", "EchoPlay.exe"
            VALUE "ProductName", "EchoPlay"
            VALUE "ProductVersion", "@ECHOPLAY_VERSION@"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
