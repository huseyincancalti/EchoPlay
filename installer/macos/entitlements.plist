<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- Re-signing the bundle after modification (rename, new Info.plist, added
         config/wrapper files) invalidates upstream's original per-file signatures
         on the ~90 bundled dylibs. Library validation must be relaxed or an
         ad-hoc-signed EchoPlay.app won't load its own bundled libraries. -->
    <key>com.apple.security.cs.disable-library-validation</key>
    <true/>
    <key>com.apple.security.cs.allow-jit</key>
    <true/>
    <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
    <true/>
</dict>
</plist>
